{
  "name": "dsh-traffic-analysis-plugin",
  "version": "0.4.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
