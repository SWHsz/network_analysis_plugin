    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "traffic-core": "workspace:*",
    "@types/node": "^24.0.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0"
