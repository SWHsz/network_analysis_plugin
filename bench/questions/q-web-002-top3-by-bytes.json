  "gold_derivation": {
    "gt_pointers": [
      "facts.conversations",
      "frames[?(@.conv==null)]"
    ],
    "session_binding": [
      {
        "gt_conv": "A",
        "tuple": {
          "proto": "tcp",
          "src": "192.168.1.4",
          "sport": 53124,
          "dst": "142.250.74.14",
          "dport": 443
        },
        "expected_conversation_id": "conv:tcp:0"
      },
      {
        "gt_conv": "B",
        "tuple": {
          "proto": "tcp",
          "src": "192.168.1.4",
          "sport": 53125,
          "dst": "93.184.216.34",
          "dport": 80
        },
        "expected_conversation_id": "conv:tcp:1"
      },
      {
        "gt_conv": "C",
        "tuple": {
          "proto": "udp",
          "src": "192.168.1.4",
          "sport": 53126,
          "dst": "8.8.8.8",
          "dport": 53
        },
        "expected_conversation_id": "conv:udp:0"
      }
    ],
    "derivation": "facts.conversations 恰有 3 个会话（A/B/C，五元组取自各条目的 src/sport/dst/dport/proto）。从前 3 名里选 3 个 = 全集 {A,B,C}，在 x-match=unordered 口径下与字节排序无关。字节量佐证（非排序依据）：A 的 4 个数据帧 note 标注 320+1440+1440+320=3520B 应用载荷，为捕获中流量最大的会话；帧 31（广播 UDP，conv=null）与帧 32（单向无应答 UDP，conv=null）在 gt 中无会话归属，不构成双向会话，不参与排名。证据帧集取 gt.conversations[].frames 全集，使部分引用（如只引数据帧）precision=1、recall<1 仍判为有效支撑（RFC-002 §6.2）。",
    "canonical_key_format": "gold_evidence 的键为规范化五元组 {proto}|{src}:{sport}>{dst}:{dport}，与 answer_schema 的 x-element-key 一致；判分前对 answer 元素按同规则规范化",
    "tolerance_note": "无序集合精确比对，无容差"
  },
  "reference_solution": {
    "steps": [
      {
        "n": 1,
        "tool": "traffic_open",
        "input": "fixtures/web-session.pcap",
        "expect": "确立 capture_id；packet_count=32"
      },
      {
        "n": 2,
        "tool": "traffic_overview",
        "input": "—",
        "expect": "会话列表 3 条（Conversation.bytes 含双向字节计数），另有单包 UDP 流不构成双向会话"
      },
      {
        "n": 3,
        "tool": "（组答）",
        "input": "按 bytes 总和降序取前 3",
        "expect": "{A, B, C} 三个五元组 + 各自代表性帧作为 evidence"
      }
    ],
    "bash_equivalent": "tshark -r fixtures/web-session.pcap -q -z conv,tcp -z conv,udp  # 双向表仅 3 条会话；广播/单向流须按『双向会话』定义排除",
    "alternative_path": "traffic_query(AST) 投影 conversation 的 bytes 字段后排序；SQL 臂 traffic_sql('SELECT ... FROM conversations ORDER BY bytes_total DESC LIMIT 3')",
    "factors": {
      "H": 2,
      "C": 1,
      "G": "会话级 top-N 聚合（3 会话）",
      "X": 1,
      "N": "low（2/32 帧为噪声，需正确排除）"
    },
    "difficulty_derivation": "备忘录 §2：H=2 且会话级 top-N 聚合 → D2；能力轴 S2（聚合统计）"
  },
