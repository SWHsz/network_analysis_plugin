{
  "question_id": "q-web-002",
  "version": 1,
  "capture": {
    "fixture": "web-session",
    "path": "fixtures/web-session.pcap",
    "gt": "ground_truth/web-session.gt.json"
  },
  "type": "set",
  "question": "列出 web-session 捕获中按传输总字节数排名前 3 的双向会话（bidirectional conversations）。以五元组作答，顺序不计。注意：单包单向流（如广播、无应答的单向 UDP）不构成双向会话。",
  "answer_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "x-kind": "set",
    "x-match": "unordered",
    "x-element-key": "{proto}|{src}:{sport}>{dst}:{dport}",
    "type": "object",
    "properties": {
      "top3_sessions": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/session_tuple"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "value",
            "evidence"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "top3_sessions"
    ],
    "additionalProperties": false,
    "$defs": {
      "session_tuple": {
        "type": "object",
        "properties": {
          "proto": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "src": {
            "type": "string"
          },
          "sport": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "dst": {
            "type": "string"
          },
          "dport": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "required": [
          "proto",
          "src",
          "sport",
          "dst",
          "dport"
        ],
        "additionalProperties": false
      }
    }
  },
