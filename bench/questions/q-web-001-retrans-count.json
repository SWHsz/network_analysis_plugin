    "x-kind": "scalar_number",
    "type": "object",
    "properties": {
      "retransmission_count": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "value",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "retransmission_count"
    ],
    "additionalProperties": false
  },
  "gold": {
    "retransmission_count": {
      "value": 3
    }
  },
