  "gold_derivation": {
    "gt_pointers": [
      "facts.retransmissions[?(@.conv=='A')]",
      "facts.conversations[?(@.id=='A')]"
    ],
    "session_binding": {
      "gt_conv": "A",
      "tuple": {
        "proto": "tcp",
        "src": "192.168.1.4",
        "sport": 53124,
        "dst": "142.250.74.14",
        "dport": 443
      },
      "expected_conversation_id": "conv:tcp:0",
      "note": "stream 号按 scapy 写入顺序推断（A 是第一条 TCP 流），判分与题面均以五元组为准绳，不依赖该推断"
    },
    "derivation": "在 ground_truth/web-session.gt.json 的 facts.retransmissions 中过滤 conv=='A' 得 3 条：{frame:8, of_frame:7, direction:c2s}、{frame:11, of_frame:10, direction:s2c}、{frame:14, of_frame:13, direction:c2s}。重传次数 = 该过滤结果的条数 = 3；证据帧 = 这 3 条的 frame 字段 = [8,11,14]。conv 'A' 的五元组来自 facts.conversations 中 id=='A' 的条目。干扰项：conv 'B'（HTTP 会话）另有 1 次重传（帧 26），不得计入。",
    "tolerance_note": "计数字段未声明 tolerance_abs，判分默认零容差（|ans - 3| <= 0）"
  },
  "reference_solution": {
    "steps": [
      {
        "n": 1,
        "tool": "traffic_open",
        "input": "fixtures/web-session.pcap",
        "expect": "确立 capture_id；packet_count=32"
      },
      {
        "n": 2,
        "tool": "traffic_inspect",
        "input": "conversation_id=conv:tcp:0（按五元组 192.168.1.4:53124→142.250.74.14:443 定位）",
        "expect": "metrics.retransmission_count=3；重传汇总的 evidence 帧为 8/11/14"
      },
      {
        "n": 3,
        "tool": "（组答）",
        "input": "—",
        "expect": "{retransmission_count: {value:3, evidence:[8,11,14]}}"
      }
    ],
    "bash_equivalent": "tshark -r fixtures/web-session.pcap -Y 'tcp.stream==0 && tcp.analysis.retransmission' -T fields -e frame.number  # → 8,11,14 共 3 行",
    "alternative_path": "traffic_query 查 events type=tcp_retransmission 且过滤该会话后计数——该路径为会话级事件聚合（H=2），不影响本题 D1 标注（难度按最短参考链推导）",
    "factors": {
